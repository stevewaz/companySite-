---
import Layout from "../layouts/Layout.astro";

const channels = [
  {
    icon: "✉️",
    title: "Email us",
    detail: "hello@acmeapp.co",
    href: "mailto:hello@acmeapp.co",
  },
  {
    icon: "💬",
    title: "Live chat",
    detail: "Mon–Fri, 9am–6pm ET",
    href: "#",
  },
  {
    icon: "📅",
    title: "Book a demo",
    detail: "20-minute walkthrough with our team",
    href: "#",
  },
];
---

<Layout
  title="Contact"
  description="Get in touch with the Acme App Co. team — sales, support, or just to say hi."
>
  <section class="section hero-sm">
    <div class="wrap hero-sm__inner">
      <span class="eyebrow">Contact</span>
      <h1>Let's talk about what you're building.</h1>
      <p>
        Whether you have a question about pricing, need a demo, or just want to
        say hi — our team usually replies within one business day.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap contact-grid">
      <div class="channels">
        {
          channels.map((c) => (
            <a class="card channel" href={c.href}>
              <span class="channel__icon" aria-hidden="true">
                {c.icon}
              </span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.detail}</p>
              </div>
            </a>
          ))
        }
      </div>

      <form class="card form" id="contact-form">
        <h2>Send us a message</h2>
        <p class="form__lede">Fill out the form and we'll get back to you shortly.</p>

        <div class="form__row">
          <label>
            Name
            <input type="text" name="name" required placeholder="Jane Doe" />
          </label>
          <label>
            Work email
            <input type="email" name="email" required placeholder="jane@company.com" />
          </label>
        </div>

        <label>
          Company
          <input type="text" name="company" placeholder="Acme Inc." />
        </label>

        <label>
          How can we help?
          <textarea name="message" rows="5" required placeholder="Tell us a bit about your team and what you're looking for."></textarea>
        </label>

        <button type="submit" class="btn btn--primary btn--block">Send message</button>
        <p class="form__status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (status) {
      status.textContent =
        "Thanks! This form is a static demo, so wire it up to your email service or CRM to start receiving real messages.";
    }
    form.reset();
  });
</script>

<style>
  .hero-sm__inner {
    max-width: 640px;
  }

  .hero-sm h1 {
    font-size: clamp(2.1rem, 4vw, 2.8rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    gap: 24px;
    align-items: start;
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channel {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .channel:hover {
    border-color: #3a4152;
  }

  .channel__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(124, 92, 255, 0.12);
    font-size: 1.1rem;
  }

  .channel h3 {
    font-size: 1rem;
    margin-bottom: 4px;
    color: var(--text);
  }

  .channel p {
    margin: 0;
    font-size: 0.88rem;
  }

  .form h2 {
    font-size: 1.3rem;
  }

  .form__lede {
    font-size: 0.92rem;
    margin-bottom: 24px;
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 16px;
  }

  input,
  textarea {
    font: inherit;
    font-weight: 400;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 11px 14px;
    color: var(--text);
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }

  .form__status {
    margin: 14px 0 0;
    font-size: 0.85rem;
    color: var(--accent-2);
    min-height: 1.2em;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
